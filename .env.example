# Copie para .env e preencha. NUNCA versione o .env preenchido.
#
# A aplicacao le este arquivo na subida (spring.config.import no application.yml), entao vale
# tanto para "mvnw spring-boot:run" quanto para o docker compose. E o jeito mais simples no
# Windows: variavel de ambiente de PowerShell some ao fechar a janela, e passar -Dchave=valor
# na linha de comando esbarra no parser dele.

# --- Perfil ---
# Sem esta linha a aplicacao sobe no perfil dev (Ollama local). Descomente para trocar o
# provedor de IA sem mexer em mais nada.
#
# groq e o caminho mais curto para rodar de graca: a cota e da conta, nao capacidade
# compartilhada como os endpoints :free do OpenRouter - la o 429 chega na primeira requisicao
# porque a fila e de todos os usuarios do gateway.
#spring.profiles.active=groq
#spring.profiles.active=openrouter

# --- Banco de dados (docker-compose.yml sobe este Postgres) ---
DB_URL=jdbc:postgresql://localhost:5432/eventos
DB_NAME=eventos
DB_USER=eventos
DB_PASSWORD=eventos

# --- Produção (docker-compose.prod.yml) ---
# Porta em que o frontend fica exposto.
PORTA_PUBLICA=8081

# --- JWT (HS256) ---
# Minimo 32 bytes. Gere com: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-no-minimo-32-bytes

# --- URL publica usada no certificado ---
APP_URL=http://localhost:8080

# --- Fuso horário ---
# O sistema opera em horário de Brasília. Num servidor em UTC isto é o que mantém a janela de
# check-in e a checagem de evento terminado corretas.
TZ=America/Sao_Paulo

# --- Documentação da API ---
# O Swagger descreve a superfície inteira da API. Fica desligado por padrão; ligue só onde
# faz sentido (o perfil dev já liga sozinho).
SWAGGER_HABILITADO=false

# --- CORS ---
# Origens aceitas pelo navegador, separadas por vírgula. Aceita curinga de porta.
CORS_ORIGENS=http://localhost:*,http://127.0.0.1:*

# --- IA ---
# false desliga a extracao por IA; a API responde 503 IA_INDISPONIVEL e o frontend cai no formulario manual (RN-10)
IA_HABILITADA=true
# Perfil "openai" (apresentacao). No perfil dev usamos Ollama local e esta chave nao e necessaria.
OPENAI_API_KEY=

# Perfil "groq": chave gratuita em https://console.groq.com/keys, sem cartao. A cota e por
# organizacao (todas as chaves somam), e o limite por minuto e por modelo - por isso o perfil
# ja vem com uma rotacao de tres. Para trocar a lista, GROQ_MODELOS separado por virgula.
GROQ_API_KEY=
#GROQ_MODELOS=

# Perfil "openrouter": um gateway so para modelos hospedados de varios fornecedores. A API e
# compativel com a da OpenAI, entao usa o mesmo starter - muda so a base-url.
OPENROUTER_API_KEY=

# Rotacao de modelos, separados por virgula. Um endpoint :free sozinho nao e utilizavel: e
# capacidade compartilhada entre todos os usuarios do OpenRouter, entao recusa com 429
# "Provider returned error" mesmo na primeira requisicao da sua conta. Com vários na lista, a
# chamada tenta o proximo e a recusa de um deixa de ser espera para todos.
#
# Monte a sua a partir do catalogo de hoje - o README (secao "Rodando de graca") traz o comando
# de PowerShell e o de jq que imprimem esta linha pronta. Slug de embedding, rerank ou audio na
# lista nao e problema: recusa a chamada e a rotacao segue adiante.
#OPENROUTER_MODELOS=fornecedor/um:free,fornecedor/dois:free

# Modelo unico, para quando nao se quer surpresa (uma apresentacao, por exemplo). Ignorado se
# OPENROUTER_MODELOS estiver preenchido. Sem nenhum dos dois vale o padrao do
# application-openrouter.yml, que e um modelo pago - centavos por mes no uso deste projeto.
#OPENROUTER_MODEL=
