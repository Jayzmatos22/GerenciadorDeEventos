# Copie para .env e preencha. NUNCA versione o .env preenchido.

# --- Banco de dados (docker-compose.yml sobe este Postgres) ---
DB_URL=jdbc:postgresql://localhost:5432/eventos
DB_USER=eventos
DB_PASSWORD=eventos

# --- JWT (HS256) ---
# Minimo 32 bytes. Gere com: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-no-minimo-32-bytes

# --- URL publica usada no certificado ---
APP_URL=http://localhost:8080

# --- Fuso horário ---
# O sistema opera em horário de Brasília. Num servidor em UTC isto é o que mantém a janela de
# check-in e a checagem de evento terminado corretas.
TZ=America/Sao_Paulo

# --- CORS ---
# Origens aceitas pelo navegador, separadas por vírgula. Aceita curinga de porta.
CORS_ORIGENS=http://localhost:*,http://127.0.0.1:*

# --- IA ---
# false desliga a extracao por IA; a API responde 503 IA_INDISPONIVEL e o frontend cai no formulario manual (RN-10)
IA_HABILITADA=true
# Perfil "openai" (apresentacao). No perfil dev usamos Ollama local e esta chave nao e necessaria.
OPENAI_API_KEY=
